# 复制到服务器项目目录（/www/wwwroot/kindle-calendar）并命名为 .env
# docker compose 会自动读取同目录 .env，覆盖 compose 文件里的默认值
# 本文件只是模板，已被 .gitignore 排除的 .env 不会进仓库

# ── 显示配置 ──────────────────────────────
LOCATION_NAME=北京
LATITUDE=39.9042
LONGITUDE=116.4074
TIMEZONE=Asia/Shanghai
SCREEN_WIDTH=758
SCREEN_HEIGHT=1024

# ── 管理端（只写在服务器这份 .env，不要提交、不要放进 GitHub Secrets）──
# 留空则 /admin 显示「管理端未启用」
ADMIN_PASSWORD=
# 会话签名。留空则每次重建容器都要重新登录。可用 openssl rand -hex 32 生成
SECRET_KEY=

# ── CI/CD 部署（docker-compose.acr.yml 使用）──
# 完整镜像地址，在 ACR 控制台仓库详情页点「公网地址」复制，结尾加 :latest
# 新版个人版实例形如 crpi-xxxx.cn-beijing.personal.cr.aliyuncs.com
# 老版形如 registry.cn-hangzhou.aliyuncs.com
ACR_IMAGE=crpi-xxxxxxxx.cn-beijing.personal.cr.aliyuncs.com/your-namespace/kindle-calendar:latest
