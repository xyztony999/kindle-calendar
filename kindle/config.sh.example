# Kindle 端配置 — 复制为 config.sh 后修改
# 部署: scp config.sh root@<Kindle的IP>:/mnt/us/kindle-calendar/config.sh

# ── v2 分区模式（推荐）──
# 云端 v2 服务的 env 端点，Kindle 据此拉取分区图与时钟字形
API_URL="https://your-app.onrender.com/api/v1/dashboard.env"

# 分钟级时钟开关（1=开启；时钟离线本地跳，不耗流量）
CLOCK_ENABLED=1

# ── v2.1 页面集与导航 ──
# 以下 ROTATE_* 仅在云端 env 拉取失败时兜底。拉取成功后以服务端下发值为准，不会回写覆盖。
# 自动轮播开关（无触摸时的降级导航）：1=开启
ROTATE_ENABLED=1
# 轮播停留秒数：今日页 / 其余页（env 成功时被 ROTATE_TODAY_S、ROTATE_{PAGE}_S 覆盖）
ROTATE_TODAY_S=120
ROTATE_OTHER_S=30
# 触摸后轮播让位秒数（触摸翻页后暂停轮播；env 成功时被 ROTATE_SUPPRESS_S 覆盖）
ROTATE_SUPPRESS_S=120

# ── 触摸模式（v2.1）──
# force（默认）：检测到 bin/tapread 即进入沉浸模式（tapread 已真机验证）
# auto         ：tapread 先跑 TOUCH_VERIFY_S 秒，收到触摸事件才进沉浸（新设备首用建议）
# off          ：纯轮播，不启触摸
TOUCH_MODE=force
# auto 验证窗口秒数；沉浸后无触摸事件自动恢复系统界面的秒数（0=关闭，
# tapread 稳定后建议保持 0，避免久置被误踢回书库）
TOUCH_VERIFY_S=90
TOUCH_DEAD_S=0

# ── v1 整图模式（回退用）──
# API_URL 为空或缺少 fbink 时，回退为定时拉取整张 PNG
SERVER_URL="https://your-app.onrender.com/dashboard.png"

# 拉取间隔（秒），建议 ≥ 900；时钟每分钟走，不受此限制
INTERVAL=900

# v1 模式：每 N 次局部刷新后做一次全刷，清除残影
FULL_REFRESH_EVERY=6

# false = 保持 WiFi 常开（推荐，不会出现飞行模式图标）
# true  = 拉取完关 WiFi 省电（状态栏会像开了飞行模式）
WIFI_ON_DEMAND=false

# 脚本书模式：false=按 Home 返回书库（推荐）  true=全屏沉浸（只能重启退出）
BOOK_FULLSCREEN=false

# WiFi 连接等待秒数
WIFI_WAIT=15
